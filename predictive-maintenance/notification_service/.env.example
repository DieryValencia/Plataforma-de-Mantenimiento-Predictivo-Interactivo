# Telegram (recomendado para celular + botones de decisión)
# 1. Crear bot con @BotFather → copiar token
# 2. Enviar /start al bot y obtener chat_id vía https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=8981814515:AAHVxe3lQ-8FbOwx4YIZDNvqvEKXYTkyGgE
TELEGRAM_CHAT_ID=1216488595

# Solo críticas al móvil (true) o también advertencias (false + NOTIFY_WARNINGS=true)
NOTIFY_CRITICAL_ONLY=true
NOTIFY_WARNINGS=false

# Push simple alternativo (app ntfy en el celular) — opcional
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# URLs internas Docker
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672
DECIDE_URL=http://action_dispatcher:3000/decide
PUBLIC_BASE_URL=http://localhost:3003

# Cola anti-saturación Telegram (ms entre mensajes / mínimo entre envíos)
TELEGRAM_QUEUE_DELAY_MS=5000
TELEGRAM_MIN_INTERVAL_MS=3500
MAX_NOTIFY_QUEUE=25
