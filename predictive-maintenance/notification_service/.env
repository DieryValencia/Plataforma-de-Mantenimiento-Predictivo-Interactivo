# ============================================================
# TELEGRAM (Notificaciones de alertas críticas)
# ============================================================
# 1. Crear bot con @BotFather → copiar token
# 2. Enviar /start al bot y obtener chat_id vía https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=8993332814:AAEnoQzmwAJmmUF9VHe4S9lcVTXUcMa5NvE
TELEGRAM_CHAT_ID=1216488595

# ============================================================
# NOTIFICACIONES (Configuración de qué enviar)
# ============================================================
# Solo críticas al móvil (true) o también advertencias (false + NOTIFY_WARNINGS=true)
NOTIFY_CRITICAL_ONLY=true
NOTIFY_WARNINGS=true

# ============================================================
# TELEGRAM QUEUE (Control de envíos para evitar conflictos)
# ============================================================
# Delay entre intentos de polling a Telegram (ms)
TELEGRAM_QUEUE_DELAY_MS=5000
# Intervalo mínimo entre envíos de mensajes (ms)
TELEGRAM_MIN_INTERVAL_MS=3500
# Máximo de alertas en cola antes de descartar
MAX_NOTIFY_QUEUE=25

# ============================================================
# PUSH ALTERNATIVO (app ntfy en el celular) — opcional
# ============================================================
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ============================================================
# URLs INTERNAS DOCKER
# ============================================================
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672
DECIDE_URL=http://action_dispatcher:3000/decide
PUBLIC_BASE_URL=http://localhost:3003
HTTP_PORT=3003
